# GEMINI_API_KEY: enables live model analysis. Without it the app runs in local
# simulation mode and says so in the header, rather than failing.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: override the model ID without a code change.
# Default: gemini-3.6-flash
# GEMINI_MODEL="gemini-3.6-flash"

# PORT: injected by Cloud Run. Defaults to 8080 locally.
# PORT=8080

# RATE_LIMIT_PER_MINUTE: per-instance cap on model-backed API calls. Default 20.
# RATE_LIMIT_PER_MINUTE=20

# UPSTREAM_TIMEOUT_MS: abort a hung model call. Default 90000.
# UPSTREAM_TIMEOUT_MS=90000

# APP_URL: the URL where this app is hosted, if you need self-referential links.
# APP_URL="MY_APP_URL"
